+++ b/sql/2026-10-23-lock-premium-columns.sql
@@ -0,0 +1,37 @@
+-- Lock the paid Teacher Edition / quiz PDF URLs out of the public API.
+--
+-- RUN ONLY AFTER the site code that reads explicit columns (no select('*')) is
+-- live on BOTH sites. Run against the old code, the category/level pages
+-- break ("Could not load worksheets"), because PostgREST refuses select=*.
+--
+-- The Netlify functions use the service role key, which these grants don't
+-- touch, so get-teacher-edition-url / get-quiz-url keep working for Premium.
+-- Uploads still work: the upload page inserts without reading the row back.
+
+-- ── Spanishido (project trlavtvbglzugwjevuen) ──────────────────────────────
+revoke select on public.worksheets from anon, authenticated;
+grant select (id, slug, title, level, category, tags, description, file_url, file_type,
+  is_free, downloads, uploaded_by, uploader_name, thumbnail_url, created_at, rating,
+  ratings_count, topic_key, piece_type, has_teacher_edition)
+  on public.worksheets to anon, authenticated;
+
+revoke select on public.quizzes from anon, authenticated;
+grant select (id, topic_key, level, title, skills, created_at) on public.quizzes to anon, authenticated;
+
+-- ── Workshido (project mhbgxdsdaalvtgobnvbh) ───────────────────────────────
+-- Same as above plus description_long, which only Workshido has:
+-- revoke select on public.worksheets from anon, authenticated;
+-- grant select (id, slug, title, level, category, tags, description, description_long,
+--   file_url, file_type, is_free, downloads, uploaded_by, uploader_name, thumbnail_url,
+--   created_at, rating, ratings_count, topic_key, piece_type, has_teacher_edition)
+--   on public.worksheets to anon, authenticated;
+-- revoke select on public.quizzes from anon, authenticated;
+-- grant select (id, topic_key, level, title, skills, created_at) on public.quizzes to anon, authenticated;
+--
+-- Workshido also still holds the old Spanishido copy in schema "es" (143
+-- worksheets, unused since 22/09/2026), with the same public read policies:
+-- revoke all on all tables in schema es from anon, authenticated;
+
+-- ── Check (as anon) ─────────────────────────────────────────────────────────
+-- GET /rest/v1/worksheets?select=teacher_edition_url&limit=1  -> 401 permission denied
+-- GET /rest/v1/worksheets?select=id,title&limit=1             -> 200
